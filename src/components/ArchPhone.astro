    <rect class="box" x="640" y="146" width="210" height="110" rx="14"/><text class="lbl" x="656" y="176">Kotlin module</text><text class="sub" x="656" y="196">Shizuku: read_screen · tap</text><text class="sub" x="656" y="214">type_text · toggle_setting</text><text class="sub" x="656" y="232">Android alarms</text>
    <rect class="box" x="640" y="272" width="210" height="108" rx="14"/><text class="lbl" x="656" y="302">Expo modules</text><text class="sub" x="656" y="322">calendar · reminders</text><text class="sub" x="656" y="340">maps · call · SMS · mail</text><text class="sub" x="656" y="358">local auth · notifications</text>
    <rect class="box" x="900" y="20" width="190" height="236" rx="14"/><text class="lbl" x="916" y="50">System apps</text><text class="sub" x="916" y="74">Clock · Calendar</text><text class="sub" x="916" y="94">Reminders · Maps</text><text class="sub" x="916" y="114">Settings (via Shizuku)</text>
    <rect class="box am" x="900" y="272" width="190" height="108" rx="14"/><text class="lbl" x="916" y="302">Your computer</text><text class="sub" x="916" y="322">desktop engine</text><text class="sub" x="916" y="340">via encrypted relay</text><text class="sub" x="916" y="358">push: APNs / FCM</text>
