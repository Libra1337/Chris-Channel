---
// Device frames: phone (iOS / android), laptop, browser, plain card. Content goes in the slot.
interface Props { kind: 'phone' | 'android' | 'laptop' | 'browser' | 'plain'; url?: string; class?: string; style?: string }
const { kind, url = '', class: cls = '', style } = Astro.props;
const k = kind === 'android' ? 'phone android' : kind;
---
<figure class={`dev ${k} ${cls}`} style={style}>
  {kind === 'laptop' ? (
    <><div class="bezel"><div class="scr"><slot /></div></div><div class="base" aria-hidden="true"></div></>
  ) : kind === 'browser' ? (
    <><div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>{url}</span></div><div class="scr"><slot /></div></>
  ) : (
    <div class="scr"><slot /></div>
  )}
  <slot name="caption" />
</figure>
