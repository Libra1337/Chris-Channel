---
// Small static concept illustrations (SVG) for projects that are libraries or private services.
// code: three protocols fan into one event type. contract: one schema shared by server and panel.
// flow: public page → captcha → service → SQLite, admin → CSV import.
interface Props { kind: 'code' | 'contract' | 'flow' }
const { kind } = Astro.props;
---
<svg class="concept" viewBox="0 0 640 360" aria-hidden="true">
  <defs>
    <linearGradient id={`cg-${kind}`} x1="0" x2="1"><stop offset="0" stop-color="#24B3CD" stop-opacity=".9"/><stop offset="1" stop-color="#F0A465" stop-opacity=".9"/></linearGradient>
  </defs>
  {kind === 'code' && (
    <g fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1.2">
      <g transform="skewY(-8) translate(60 120)">
        {['Responses SSE', 'Messages SSE', 'Chat SSE'].map((t, i) => (
          <g transform={`translate(0 ${i * 62})`}><rect width="170" height="44" rx="8" fill="#141416"/><text x="14" y="27" fill="#d0d0d4" stroke="none" font-size="13">{t}</text></g>
        ))}
      </g>
      <path d="M232 132C300 132 300 190 360 190M232 186H360M232 240C300 240 300 194 360 194" stroke={`url(#cg-${kind})`} stroke-width="1.6"/>
      <g transform="skewY(-8) translate(362 236)"><rect width="200" height="64" rx="10" fill="#101418" stroke="#24B3CD"/><text x="16" y="28" fill="#fff" stroke="none" font-size="14">WireEvent</text><text x="16" y="48" fill="#8e8e93" stroke="none" font-size="11">text · reasoning · tool_call · usage</text></g>
    </g>
  )}
  {kind === 'contract' && (
    <g fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1.2">
      <g transform="translate(232 40)"><rect width="176" height="96" rx="10" fill="#18130e" stroke="#F0A465"/><text x="16" y="30" fill="#fff" stroke="none" font-size="14">shared/</text><text x="16" y="52" fill="#c8b8a4" stroke="none" font-size="11">z.object({'{'} model, … {'}'})</text><text x="16" y="72" fill="#8e8e93" stroke="none" font-size="11">types · aliases · schemas</text></g>
      <path d="M280 136C240 190 170 190 150 220M360 136C400 190 470 190 490 220" stroke={`url(#cg-${kind})`} stroke-width="1.6" stroke-dasharray="5 6"/>
      <g transform="translate(60 222)"><rect width="190" height="88" rx="10" fill="#141416"/><text x="16" y="30" fill="#fff" stroke="none" font-size="14">server/</text><text x="16" y="52" fill="#8e8e93" stroke="none" font-size="11">Bun · Hono · Drizzle</text><text x="16" y="70" fill="#8e8e93" stroke="none" font-size="11">PostgreSQL</text></g>
      <g transform="translate(390 222)"><rect width="190" height="88" rx="10" fill="#141416"/><text x="16" y="30" fill="#fff" stroke="none" font-size="14">web/</text><text x="16" y="52" fill="#8e8e93" stroke="none" font-size="11">React Router</text><text x="16" y="70" fill="#8e8e93" stroke="none" font-size="11">shadcn/ui</text></g>
    </g>
  )}
  {kind === 'flow' && (
    <g fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1.2">
      {[['Public page', 40, 70], ['Geetest v4', 200, 70], ['Spring Boot', 360, 70], ['SQLite', 500, 160], ['Admin page', 40, 250], ['CSV import', 200, 250]].map(([t, x, y]) => (
        <g transform={`translate(${x} ${y})`}><rect width="120" height="48" rx="9" fill="#141416"/><text x="14" y="29" fill="#d0d0d4" stroke="none" font-size="12.5">{t}</text></g>
      ))}
      <path d="M160 94H200M320 94H360M480 94C520 94 540 120 560 160M160 274H200M320 274C420 274 470 250 500 208" stroke={`url(#cg-${kind})`} stroke-width="1.6"/>
    </g>
  )}
</svg>
