---
// The 林光 mark (two trunks + a floating beam), from the final logo geometry (viewBox 488.92 x 640).
// mode="light": assembles from light: both trunk outlines draw in, fill, the beam slides in, then a band of
//               light sweeps across the whole mark and the glow breathes once. Click or Enter replays (mod/mark).
// mode="launch": the desktop app's launch timetable (trunks rise, beam falls in, one glow).
// mode="static": no motion.
interface Props { brand?: 'aogiri' | 'lynshen'; mode?: 'light' | 'launch' | 'static'; class?: string; id?: string; title?: string; replay?: boolean }
const { brand = 'aogiri', mode = 'static', class: cls = '', id = 'mk', title, replay = false } = Astro.props;
const [a, b] = brand === 'aogiri' ? ['#FFE3BC', '#F0A465'] : ['#B5ECF4', '#24B3CD'];
const ink = brand === 'aogiri' ? '#F6EEE3' : '#EEF0EE';
const T1 = 'M0 256.59V588.21a51.79 51.79 0 0 0 103.58 0V256.59a51.79 51.79 0 0 0-103.58 0Z';
const T2 = 'M385.33 51.79V588.21a51.79 51.79 0 0 0 103.59 0V51.79a51.79 51.79 0 0 0-103.59 0Z';
const RAY = 'M144.01 144.43 241.79 413.08a36.25 36.25 0 0 0 68.13-24.8L212.14 119.63a36.25 36.25 0 0 0-68.13 24.8Z';
const label = title || (replay ? 'Replay the logo animation' : undefined);
---
<svg class={`mark m-${mode} ${cls}`} viewBox="-60 -40 608.92 720" data-brand={brand}
  role={label ? (replay ? 'button' : 'img') : undefined} aria-hidden={label ? undefined : 'true'} aria-label={label}
  tabindex={replay ? 0 : undefined} data-module={replay ? 'mark' : undefined}>
  <defs>
    <linearGradient id={`${id}-l`} gradientUnits="userSpaceOnUse" x1="165.67" y1="97.97" x2="288.25" y2="434.75"><stop offset="0" stop-color={a}/><stop offset="1" stop-color={b}/></linearGradient>
    <radialGradient id={`${id}-g`}><stop offset="0" stop-color={b} stop-opacity=".55"/><stop offset=".6" stop-color={b} stop-opacity=".12"/><stop offset="1" stop-color={b} stop-opacity="0"/></radialGradient>
    <linearGradient id={`${id}-s`} x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".95"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
    <clipPath id={`${id}-c`}><rect x="-60" y="-40" width="608.92" height="680"/></clipPath>
    <clipPath id={`${id}-u`}><path d={T1}/><path d={T2}/><path d={RAY}/></clipPath>
  </defs>
  <circle class="mk-glow" cx="227" cy="300" r="300" fill={`url(#${id}-g)`}/>
  <g clip-path={`url(#${id}-c)`}>
    <path class="mk-t1" d={T1} fill={ink}/>
    <path class="mk-t2" d={T2} fill={ink}/>
  </g>
  {mode === 'light' && <g class="mk-lines" fill="none" stroke={a} stroke-width="5" stroke-linecap="round">
    <path class="mk-o1" d={T1} pathLength="1"/><path class="mk-o2" d={T2} pathLength="1"/>
  </g>}
  <path class="mk-ray" d={RAY} fill={`url(#${id}-l)`}/>
  {mode === 'light' && <g clip-path={`url(#${id}-u)`}><rect class="mk-sweep" x="-260" y="-40" width="220" height="720" fill={`url(#${id}-s)`} transform="rotate(20 227 300)"/></g>}
</svg>
<style>
  .mark { overflow: visible; }
  .mark .mk-glow { opacity: 0; }
  .mark path, .mark rect, .mark circle { transform-box: fill-box; }
  .mark[role="button"] { cursor: pointer; border-radius: 1.2rem; }
  /* Launch timeline from the desktop app (launch.ts): 100/260/820/1100 ms starts. */
  .m-launch .mk-t1 { animation: mk-rise .7s var(--ease-out) .1s backwards; }
  .m-launch .mk-t2 { animation: mk-rise .7s var(--ease-out) .26s backwards; }
  .m-launch .mk-ray { animation: mk-fall .64s var(--ease-out) .82s backwards; }
  .m-launch .mk-glow { animation: mk-glow .7s var(--ease-io) 1.1s both; }
  /* Assemble from light: outlines draw (0.15–1.25 s), fills rise in (0.9–1.5 s), beam (1.35 s), sweep (1.9 s), glow. */
  .m-light .mk-o1, .m-light .mk-o2 { stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; animation: mk-draw 1.1s var(--ease-io) .15s forwards, mk-out .6s ease 1.6s forwards; }
  .m-light .mk-o2 { animation-delay: .35s, 1.75s; }
  .m-light .mk-t1, .m-light .mk-t2 { animation: mk-fill .7s var(--ease-out) .95s backwards; }
  .m-light .mk-t2 { animation-delay: 1.1s; }
  .m-light .mk-ray { animation: mk-fall .7s var(--ease-out) 1.35s backwards; }
  .m-light .mk-sweep { transform-box: view-box; animation: mk-sweep 1.15s var(--ease-io) 1.9s backwards; translate: 1200px 0; }
  .m-light .mk-glow { animation: mk-glow 1.4s var(--ease-io) 2.1s both; }
  .mark.replaying * { animation-name: none !important; }
  @keyframes mk-rise { from { transform: translateY(101%); } }
  @keyframes mk-fall { from { transform: translate(-15%, -42%); opacity: 0; } 50% { opacity: 1; } }
  @keyframes mk-glow { 0% { opacity: 0; } 45% { opacity: 1; } 100% { opacity: .35; } }
  @keyframes mk-draw { 0% { opacity: 1; stroke-dashoffset: 1; } 100% { opacity: 1; stroke-dashoffset: 0; } }
  @keyframes mk-out { to { opacity: 0; } }
  @keyframes mk-fill { from { opacity: 0; transform: scaleY(.96); filter: brightness(2); } }
  @keyframes mk-sweep { from { translate: 0 0; } to { translate: 1200px 0; } }
  @media (prefers-reduced-motion: reduce) { .mark .mk-glow { opacity: .35; } .mark .mk-lines, .mark .mk-sweep { display: none; } }
</style>
